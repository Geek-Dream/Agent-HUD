                                        FontSize="11"
                                        Glyph="&#xE72B;" />
                                </Button>
                                <Grid
                                    Grid.Column="1"
                                    VerticalAlignment="Center">
                                    <StackPanel
                                        Spacing="2"
                                        Visibility="{Binding TitleVisibility}">
