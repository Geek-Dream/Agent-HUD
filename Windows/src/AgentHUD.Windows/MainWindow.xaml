                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource HudTextPrimaryBrush}"
                                            MaxLines="1"
                                            Text="{Binding DisplayTitle}"
                                            TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock
                                                FontFamily="Consolas"
                                                FontSize="9"
                                                FontWeight="Bold"
                                                Foreground="{Binding ProviderBrush}"
                                                Text="{Binding ProviderShortName}" />
                                            <TextBlock
                                                FontSize="9.5"
                                                Foreground="{ThemeResource HudTextTertiaryBrush}"
                                                Text="{Binding TitleSourceText}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Grid
                                        ColumnSpacing="4"
                                        Visibility="{Binding EditorVisibility}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            Grid.Column="0"
                                            Height="30"
                                            Background="{ThemeResource HudControlFillBrush}"
                                            BorderBrush="{ThemeResource HudBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{ThemeResource HudControlRadius}"
                                            FontSize="12"
                                            Foreground="{ThemeResource HudTextPrimaryBrush}"
                                            KeyDown="TitleEditor_KeyDown"
                                            Padding="8,4"
                                            PlaceholderText="例如：日志查询"
                                            Text="{Binding EditDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button
                                            Grid.Column="1"
                                            Click="CommitTitleButton_Click"
                                            Style="{StaticResource HudTinyButtonStyle}"
                                            Tag="{Binding}"
                                            ToolTipService.ToolTip="保存标题">
                                            <FontIcon
                                                FontFamily="Segoe Fluent Icons"
                                                FontSize="9"
                                                Glyph="&#xE73E;" />
                                        </Button>
                                        <Button
                                            Grid.Column="2"
                                            Click="CancelTitleButton_Click"
                                            Style="{StaticResource HudTinyButtonStyle}"
                                            Tag="{Binding}"
                                            ToolTipService.ToolTip="取消编辑">
                                            <FontIcon
                                                FontFamily="Segoe Fluent Icons"
                                                FontSize="9"
                                                Glyph="&#xE711;" />
                                        </Button>
                                    </Grid>
                                </Grid>
                                <Button
                                    Grid.Column="2"
                                    Click="DetailEditTitleButton_Click"
                                    Style="{StaticResource HudIconButtonStyle}"
                                    Tag="{Binding}"
                                    ToolTipService.ToolTip="编辑标题备注">
                                    <FontIcon
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="10"
                                        Foreground="{ThemeResource HudTextTertiaryBrush}"
                                        Glyph="&#xE70F;" />
                                </Button>
                                <Button
                                    Grid.Column="3"
                                    Click="StarButton_Click"
                                    Style="{StaticResource HudIconButtonStyle}"
                                    Tag="{Binding}"
                                    ToolTipService.ToolTip="标记重要">
                                    <FontIcon
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="10"
                                        Foreground="{ThemeResource HudImportantBrush}"
                                        Glyph="{Binding StarGlyph}" />
                                </Button>
                            </Grid>

                            <ScrollViewer
                                x:Name="DetailScrollViewer"
                                Grid.Row="1"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="DetailCardStack" Spacing="8">
                                    <Border
                                        Margin="12,0,12,0"
                                        Padding="14,12"
                                        Background="{ThemeResource HudRaisedBrush}"
                                        CornerRadius="{ThemeResource HudCardRadius}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Grid.Column="0"
                                                Width="38"
                                                Height="38"
                                                Background="{Binding StatusTintBrush}"
                                                CornerRadius="{ThemeResource HudCardRadius}">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontFamily="Consolas"
                                                    FontSize="12"
                                                    FontWeight="Bold"
                                                    Foreground="{Binding ProviderBrush}"
                                                    Text="{Binding ProviderInitials}" />
                                            </Border>
                                            <StackPanel
                                                Grid.Column="1"
                                                Spacing="3">
                                                <TextBlock
                                                    FontSize="10.5"
                                                    Foreground="{ThemeResource HudTextSecondaryBrush}"
                                                    Text="{Binding ProjectName}" />
                                                <TextBlock
                                                    FontFamily="Consolas"
                                                    FontSize="9.5"
                                                    Foreground="{ThemeResource HudTextTertiaryBrush}"
                                                    MaxLines="1"
                                                    Text="{Binding ProjectPath}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <TextBlock
                                                        FontSize="9.5"
                                                        Foreground="{ThemeResource HudTextTertiaryBrush}"
                                                        Text="{Binding GitText}" />
                                                    <TextBlock
                                                        FontSize="9.5"
                                                        Foreground="{ThemeResource HudTextTertiaryBrush}"
                                                        Text="{Binding DurationText}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Button
                                                Grid.Column="2"
                                                Width="28"
                                                Height="28"
                                                Padding="0"
                                                VerticalAlignment="Top"
                                                Click="OpenProjectButton_Click"
                                                Style="{StaticResource HudIconButtonStyle}"
                                                ToolTipService.ToolTip="打开目录">
                                                <FontIcon
                                                    FontFamily="Segoe Fluent Icons"
                                                    FontSize="11"
                                                    Glyph="&#xE8B7;" />
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <Border
                                        Margin="12,0,12,0"
                                        Padding="14,12"
                                        Background="{ThemeResource HudRaisedBrush}"
                                        CornerRadius="{ThemeResource HudCardRadius}">
                                        <StackPanel Spacing="9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <FontIcon
                                                        FontFamily="Segoe Fluent Icons"
                                                        FontSize="11"
                                                        Foreground="{Binding StatusBrush}"
                                                        Glyph="&#xE9D9;" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Foreground="{ThemeResource HudTextSecondaryBrush}"
                                                        Text="当前进度" />
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Column="1"
                                                    FontSize="9.5"
                                                    Foreground="{ThemeResource HudTextTertiaryBrush}"
                                                    Text="{Binding ConfidenceLabel}" />
                                            </Grid>
                                            <TextBlock
                                                FontSize="13"
                                                FontWeight="Medium"
                                                Foreground="{ThemeResource HudTextPrimaryBrush}"
                                                Text="{Binding CurrentAction}"
