                                Grid.Column="3"
                                Click="ImportantDismissButton_Click"
                                Style="{StaticResource HudTinyButtonStyle}">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="9"
                                    Glyph="&#xE711;" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid x:Name="ListPanel">
