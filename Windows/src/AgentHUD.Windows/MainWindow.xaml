                                                    <ItemsPanelTemplate>
                                                        <StackPanel
                                                            Orientation="Horizontal"
                                                            Spacing="8" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button
                                                            Padding="5"
                                                            Click="PromptImageButton_Click"
                                                            CornerRadius="{ThemeResource HudCardRadius}"
                                                            Tag="{Binding}">
                                                            <StackPanel Spacing="4">
                                                                <Border
                                                                    Width="104"
                                                                    Height="66"
                                                                    Background="{ThemeResource HudControlFillBrush}"
                                                                    CornerRadius="{ThemeResource HudMicroRadius}">
                                                                    <Image
                                                                        Stretch="UniformToFill"
                                                                        Source="{Binding ImageSource}" />
                                                                </Border>
                                                                <TextBlock
                                                                    HorizontalAlignment="Center"
                                                                    FontSize="9.5"
                                                                    Text="{Binding Label}" />
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        Margin="12,0,12,0"
                                        Padding="14,12"
                                        Background="{ThemeResource HudRaisedBrush}"
                                        CornerRadius="{ThemeResource HudCardRadius}">
                                        <StackPanel Spacing="4">
                                            <Grid Margin="0,0,0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <FontIcon
                                                        FontFamily="Segoe Fluent Icons"
                                                        FontSize="11"
                                                        Foreground="{ThemeResource HudTextSecondaryBrush}"
                                                        Glyph="&#xE9D5;" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Foreground="{ThemeResource HudTextSecondaryBrush}"
                                                        Text="完成记录" />
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Column="1"
                                                    FontSize="9.5"
                                                    Foreground="{ThemeResource HudTextTertiaryBrush}">
                                                    <Run Text="{Binding TotalRunCount}" />
                                                    <Run Text=" 轮" />
                                                </TextBlock>
                                            </Grid>

                                            <StackPanel
                                                Padding="0,18"
                                                Spacing="6"
                                                Visibility="{Binding EmptyRunsVisibility}">
                                                <FontIcon
                                                    FontFamily="Segoe Fluent Icons"
                                                    FontSize="20"
                                                    Foreground="{ThemeResource HudTextTertiaryBrush}"
                                                    Glyph="&#xE735;" />
                                                <TextBlock
                                                    FontSize="12.5"
                                                    FontWeight="Medium"
                                                    Foreground="{ThemeResource HudTextPrimaryBrush}"
                                                    Text="还没有完成记录" />
                                                <TextBlock
                                                    FontSize="10.5"
                                                    Foreground="{ThemeResource HudTextSecondaryBrush}"
                                                    Text="当前任务结束后，本地摘要会出现在这里。" />
                                            </StackPanel>

                                            <ItemsControl
                                                ItemsSource="{Binding Runs}"
                                                Visibility="{Binding RunsVisibility}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Padding="0,11" Spacing="4">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock
                                                                    FontSize="11.5"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{ThemeResource HudTextPrimaryBrush}"
                                                                    Text="{Binding Objective}"
                                                                    TextWrapping="Wrap" />
                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    Margin="8,0,0,0"
                                                                    FontSize="9"
                                                                    Foreground="{ThemeResource HudTextTertiaryBrush}"
                                                                    Text="{Binding DateText}" />
                                                            </Grid>
                                                            <TextBlock
                                                                FontSize="11"
                                                                Foreground="{ThemeResource HudTextSecondaryBrush}"
                                                                LineHeight="17"
                                                                Text="{Binding Summary}"
                                                                TextWrapping="Wrap" />
                                                            <TextBlock
                                                                FontFamily="Consolas"
                                                                FontSize="9.5"
                                                                Foreground="{ThemeResource HudTextTertiaryBrush}"
                                                                Text="{Binding Files}"
                                                                TextWrapping="Wrap"
                                                                Visibility="{Binding FilesVisibility}" />
                                                            <Border
                                                                Height="1"
                                                                Margin="0,5,0,0"
                                                                Background="{ThemeResource HudDividerBrush}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Button
                                                Height="34"
                                                Margin="0,2,0,0"
                                                HorizontalAlignment="Stretch"
                                                Click="LoadMoreButton_Click"
                                                CornerRadius="{ThemeResource HudControlRadius}"
                                                Visibility="{Binding LoadMoreVisibility}">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Rectangle
                                                        Grid.Column="0"
                                                        Height="1"
                                                        VerticalAlignment="Center"
                                                        Fill="{ThemeResource HudBorderBrush}" />
                                                    <StackPanel
                                                        Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        Spacing="5">
                                                        <FontIcon
                                                            FontFamily="Segoe Fluent Icons"
                                                            FontSize="9"
                                                            Glyph="&#xE70D;" />
                                                        <TextBlock
                                                            FontSize="10"
                                                            Text="加载 5 条" />
                                                    </StackPanel>
                                                    <Rectangle
                                                        Grid.Column="2"
                                                        Height="1"
                                                        VerticalAlignment="Center"
                                                        Fill="{ThemeResource HudBorderBrush}" />
                                                </Grid>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <Grid
                                Grid.Row="2"
                                Padding="14,0"
                                Background="{ThemeResource HudSurfaceBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="9"
                                    Foreground="{ThemeResource HudTextTertiaryBrush}"
                                    Text="本地规则摘要 · 未修改 Agent 数据" />
                                <Button
                                    Grid.Column="1"
                                    Padding="7,2"
                                    Click="ClearManualTitleButton_Click"
                                    Content="恢复自动标题"
                                    CornerRadius="{ThemeResource HudMicroRadius}"
                                    FontSize="9"
                                    Visibility="{Binding ManualTitleActionVisibility}" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>

                <Grid
                    Grid.Row="3"
                    Padding="12,0"
                    Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Grid.Column="0"
                        Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="9"
                        Foreground="{ThemeResource HudTextTertiaryBrush}"
                        Glyph="&#xE72E;" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="9"
                        Foreground="{ThemeResource HudTextTertiaryBrush}"
                        Text="只读监控" />
                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="4">
                        <Ellipse
                            Width="5"
                            Height="5"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource HudOnlineBrush}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="9"
                            Foreground="{ThemeResource HudTextTertiaryBrush}"
                            Text="{Binding FooterText}" />
                    </StackPanel>
                </Grid>

                <Border
                    x:Name="ResizeGrip"
                    Grid.RowSpan="4"
                    Width="22"
                    Height="22"
                    Margin="0,0,2,2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Canvas.ZIndex="30"
                    Background="Transparent"
                    PointerPressed="ResizeGrip_PointerPressed"
                    ToolTipService.ToolTip="拖动调整大小（480×620 至 760×1400）">
                    <Path
                        Width="15"
                        Height="15"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="M 4,14 L 14,4 M 9,14 L 14,9"
                        Opacity="0.65"
                        Stroke="{ThemeResource HudTextTertiaryBrush}"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        StrokeThickness="1.2" />
                </Border>
            </Grid>
        </Grid>
        </Border>
    </Grid>
</Window>
