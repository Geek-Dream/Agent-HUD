                                                BorderBrush="{Binding CardEdgeBrush}"
                                                BorderThickness="1,0,0,0"
                                                CornerRadius="{ThemeResource HudTileRadius}"
                                                IsHitTestVisible="False" />
                                            <Grid
                                                Padding="14,11"
                                                ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    Grid.Column="0"
                                                    Width="44"
                                                    Height="44"
                                                    VerticalAlignment="Top"
                                                    Background="{Binding ProviderTintBrush}"
                                                    BorderBrush="{Binding BadgeEdgeBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{ThemeResource HudTileRadius}">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontFamily="Consolas"
                                                        FontSize="15"
                                                        FontWeight="Bold"
                                                        Foreground="{Binding ProviderBrush}"
                                                        Text="{Binding ProviderInitials}" />
                                                </Border>
                                                <Grid
                                                    Grid.Column="1"
                                                    RowSpacing="4">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid Grid.Row="0" ColumnSpacing="6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid
                                                            Grid.Column="0"
                                                            Visibility="{Binding TitleVisibility}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                FontSize="15"
                                                                FontWeight="SemiBold"
                                                                Foreground="{ThemeResource HudTextPrimaryBrush}"
                                                                MaxLines="1"
                                                                Text="{Binding DisplayTitle}"
                                                                TextTrimming="CharacterEllipsis" />
                                                            <Button
                                                                x:Name="InlineEditButton"
                                                                Grid.Column="1"
                                                                Width="22"
                                                                Height="22"
                                                                Margin="5,0,0,0"
                                                                Padding="0"
                                                                Click="InlineEditButton_Click"
                                                                IsHitTestVisible="False"
                                                                Opacity="0"
                                                                Tag="{Binding}"
                                                                ToolTipService.ToolTip="编辑标题备注">
                                                                <FontIcon
                                                                    FontFamily="Segoe Fluent Icons"
                                                                    FontSize="9"
                                                                    Foreground="{ThemeResource HudTextTertiaryBrush}"
                                                                    Glyph="&#xE70F;" />
                                                            </Button>
                                                        </Grid>
                                                        <Grid
                                                            Grid.ColumnSpan="2"
                                                            ColumnSpacing="5"
                                                            Visibility="{Binding EditorVisibility}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox
                                                                Grid.Column="0"
                                                                Height="28"
                                                                Background="{ThemeResource HudControlFillBrush}"
                                                                BorderBrush="{ThemeResource HudBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="{ThemeResource HudControlRadius}"
                                                                FontSize="12"
                                                                Foreground="{ThemeResource HudTextPrimaryBrush}"
                                                                KeyDown="TitleEditor_KeyDown"
                                                                Padding="8,4"
                                                                Text="{Binding EditDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            <Button
                                                                Grid.Column="1"
                                                                Click="CommitTitleButton_Click"
                                                                Style="{StaticResource HudTinyButtonStyle}"
                                                                Tag="{Binding}"
                                                                ToolTipService.ToolTip="保存标题">
                                                                <FontIcon
                                                                    FontFamily="Segoe Fluent Icons"
                                                                    FontSize="9"
                                                                    Glyph="&#xE73E;" />
                                                            </Button>
                                                            <Button
                                                                Grid.Column="2"
                                                                Click="CancelTitleButton_Click"
                                                                Style="{StaticResource HudTinyButtonStyle}"
                                                                Tag="{Binding}"
                                                                ToolTipService.ToolTip="取消编辑">
                                                                <FontIcon
                                                                    FontFamily="Segoe Fluent Icons"
                                                                    FontSize="9"
                                                                    Glyph="&#xE711;" />
                                                            </Button>
                                                        </Grid>
                                                        <StackPanel
                                                            Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            Spacing="4"
                                                            VerticalAlignment="Center">
                                                            <Border
                                                                Width="28"
                                                                Height="28"
                                                                Background="{ThemeResource HudControlFillBrush}"
                                                                BorderBrush="{ThemeResource HudBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="10"
                                                                Visibility="{Binding AttachmentVisibility}">
                                                                <FontIcon
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    FontFamily="Segoe Fluent Icons"
                                                                    FontSize="12"
                                                                    Foreground="{ThemeResource HudTextSecondaryBrush}"
                                                                    Glyph="&#xE723;" />
                                                            </Border>
                                                            <Button
                                                                Width="28"
                                                                Height="28"
                                                                Padding="0"
                                                                Background="{ThemeResource HudControlFillBrush}"
                                                                BorderBrush="{ThemeResource HudBorderBrush}"
                                                                BorderThickness="1"
                                                                Click="StarButton_Click"
                                                                CornerRadius="10"
                                                                Tag="{Binding}"
                                                                ToolTipService.ToolTip="标记重要">
                                                                <FontIcon
                                                                    FontFamily="Segoe Fluent Icons"
                                                                    FontSize="12"
                                                                    Foreground="{ThemeResource HudImportantBrush}"
                                                                    Glyph="{Binding StarGlyph}" />
                                                            </Button>
                                                            <Border
                                                                Padding="9,3"
                                                                Background="{Binding StatusTintBrush}"
                                                                BorderThickness="0"
                                                                CornerRadius="{ThemeResource HudPillRadius}">
                                                                <TextBlock
                                                                    FontSize="11.5"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{Binding StatusPillTextBrush}"
                                                                    Text="{Binding StatusLabel}" />
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>
                                                    <StackPanel
                                                        Grid.Row="1"
                                                        Orientation="Horizontal"
                                                        Spacing="6">
                                                        <TextBlock
                                                            FontFamily="Consolas"
                                                            FontSize="12"
                                                            FontWeight="Bold"
                                                            Foreground="{Binding ProviderBrush}"
                                                            Text="{Binding ProviderShortName}" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            Foreground="{ThemeResource HudTextTertiaryBrush}"
                                                            Text="·" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            Foreground="{ThemeResource HudTextSecondaryBrush}"
                                                            MaxLines="1"
                                                            Text="{Binding ProjectName}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            Foreground="{ThemeResource HudTextTertiaryBrush}"
                                                            Text="·" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            Foreground="{ThemeResource HudTextSecondaryBrush}"
                                                            MaxLines="1"
                                                            Text="{Binding GitText}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Grid Grid.Row="2" ColumnSpacing="7">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse
                                                            Grid.Column="0"
                                                            Width="7"
                                                            Height="7"
                                                            VerticalAlignment="Center"
                                                            Fill="{Binding StatusBrush}" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            FontSize="11"
                                                            Foreground="{ThemeResource HudTextSecondaryBrush}"
                                                            MaxLines="1"
                                                            Text="{Binding CurrentAction}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Grid.Column="2"
                                                            FontSize="10.5"
                                                            Foreground="{ThemeResource HudTextTertiaryBrush}"
                                                            Text="{Binding ActivityAge}" />
                                                    </Grid>
                                                </Grid>
                                                <FontIcon
                                                    Grid.Column="2"
                                                    Margin="10,0,-8,0"
                                                    VerticalAlignment="Center"
                                                    FontFamily="Segoe Fluent Icons"
                                                    FontSize="17"
                                                    Foreground="{ThemeResource HudTextSecondaryBrush}"
                                                    Glyph="&#xE76C;" />
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="9"
                            Visibility="{Binding EmptyVisibility}">
                            <FontIcon
                                HorizontalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="23"
                                Foreground="{ThemeResource HudTextTertiaryBrush}"
                                Glyph="&#xE9D9;" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="12.5"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource HudTextPrimaryBrush}"
                                Text="当前筛选没有会话" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="10.5"
                                Foreground="{ThemeResource HudTextSecondaryBrush}"
                                Text="本地 Codex、Claude、Pi 与 OpenCode 会话会在这里出现" />
                        </StackPanel>

                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="10"
                            Visibility="{Binding LoadingVisibility}">
                            <ProgressRing
                                Width="24"
                                Height="24"
                                Foreground="{ThemeResource HudCodexBrush}"
                                IsActive="True" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="10.5"
                                Foreground="{ThemeResource HudTextSecondaryBrush}"
                                Text="正在读取本地会话" />
                            <StackPanel Margin="0,8,0,0" Spacing="8" Width="280">
                                <Border
                                    x:Name="LoadingSkeleton1"
                                    Height="58"
                                    Padding="12,10"
                                    Background="{ThemeResource HudRaisedBrush}"
                                    BorderBrush="{ThemeResource HudBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{ThemeResource HudCardRadius}"
                                    Opacity="0.35">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" Background="{ThemeResource HudControlFillBrush}" CornerRadius="{ThemeResource HudCardRadius}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="7">
                                            <Border Width="150" Height="8" HorizontalAlignment="Left" Background="{ThemeResource HudControlFillBrush}" CornerRadius="{ThemeResource HudMicroRadius}" />
                                            <Border Width="100" Height="6" HorizontalAlignment="Left" Background="{ThemeResource HudControlFillBrush}" CornerRadius="{ThemeResource HudMicroRadius}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border
                                    x:Name="LoadingSkeleton2"
                                    Height="58"
                                    Padding="12,10"
                                    Background="{ThemeResource HudRaisedBrush}"
                                    BorderBrush="{ThemeResource HudBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{ThemeResource HudCardRadius}"
                                    Opacity="0.35">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" Background="{ThemeResource HudControlFillBrush}" CornerRadius="{ThemeResource HudCardRadius}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="7">
                                            <Border Width="150" Height="8" HorizontalAlignment="Left" Background="{ThemeResource HudControlFillBrush}" CornerRadius="{ThemeResource HudMicroRadius}" />
                                            <Border Width="100" Height="6" HorizontalAlignment="Left" Background="{ThemeResource HudControlFillBrush}" CornerRadius="{ThemeResource HudMicroRadius}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border
                                    x:Name="LoadingSkeleton3"
                                    Height="58"
                                    Padding="12,10"
                                    Background="{ThemeResource HudRaisedBrush}"
                                    BorderBrush="{ThemeResource HudBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{ThemeResource HudCardRadius}"
                                    Opacity="0.35">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" Background="{ThemeResource HudControlFillBrush}" CornerRadius="{ThemeResource HudCardRadius}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="7">
                                            <Border Width="150" Height="8" HorizontalAlignment="Left" Background="{ThemeResource HudControlFillBrush}" CornerRadius="{ThemeResource HudMicroRadius}" />
                                            <Border Width="100" Height="6" HorizontalAlignment="Left" Background="{ThemeResource HudControlFillBrush}" CornerRadius="{ThemeResource HudMicroRadius}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Grid
                        x:Name="DetailPanel"
                        Visibility="{Binding DetailVisibility}">
                        <Grid DataContext="{Binding SelectedRow}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="52" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="26" />
                            </Grid.RowDefinitions>

                            <Grid
                                Grid.Row="0"
                                Padding="12,8,11,6"
                                ColumnSpacing="8"
                                PointerPressed="DragSurface_PointerPressed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    Grid.Column="0"
                                    Click="DetailBackButton_Click"
