                                <TransitionCollection />
                            </ListView.ItemContainerTransitions>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        x:Name="RowHoverSurface"
                                        Margin="6,0"
                                        Background="Transparent"
                                        PointerEntered="RowHoverSurface_PointerEntered"
                                        PointerExited="RowHoverSurface_PointerExited">
