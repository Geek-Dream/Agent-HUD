                                                FontFamily="Consolas"
                                                FontSize="9.5"
                                                Foreground="{ThemeResource HudTextSecondaryBrush}"
                                                Text="{Binding CurrentFilesText}"
                                                TextWrapping="Wrap"
                                                Visibility="{Binding CurrentFilesVisibility}" />
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        Margin="12,0,12,0"
                                        Padding="14,12"
                                        Background="{ThemeResource HudRaisedBrush}"
                                        CornerRadius="{ThemeResource HudCardRadius}">
                                        <StackPanel Spacing="9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <FontIcon
                                                        FontFamily="Segoe Fluent Icons"
                                                        FontSize="11"
                                                        Foreground="{ThemeResource HudTextSecondaryBrush}"
                                                        Glyph="&#xE8BD;" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Foreground="{ThemeResource HudTextSecondaryBrush}"
                                                        Text="用户原始输入" />
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Column="1"
                                                    FontSize="9.5"
                                                    Foreground="{ThemeResource HudTextTertiaryBrush}"
                                                    Text="{Binding PromptDateText}" />
                                            </Grid>
                                            <Border
                                                Padding="11"
                                                Background="{ThemeResource HudControlFillBrush}"
                                                CornerRadius="{ThemeResource HudControlRadius}">
                                                <TextBlock
                                                    FontSize="11.5"
                                                    Foreground="{ThemeResource HudTextPrimaryBrush}"
                                                    IsTextSelectionEnabled="True"
                                                    LineHeight="18"
                                                    Text="{Binding PromptText}"
                                                    TextWrapping="Wrap" />
                                            </Border>
                                            <ItemsControl
                                                ItemsSource="{Binding PromptImages}"
                                                Visibility="{Binding PromptImagesVisibility}">
