<Window
    x:Class="AgentHUD.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AgentHUD.Windows">

    <Grid Background="#FF02060D">
        <!-- Composition host: the neon rim is drawn with GPU primitives
             (ShapeVisual + geoms + drop shadows) in MainWindow.xaml.cs. -->
        <Grid x:Name="BackdropHost" Background="#FF02060D" />
        <Grid x:Name="GlowHost" IsHitTestVisible="False" Visibility="Collapsed" />
        <Border
            x:Name="RootBorder"
            Margin="2"
            Background="Transparent"
            BorderBrush="{ThemeResource HudRimStrokeBrush}"
            BorderThickness="1.2"
            CornerRadius="{ThemeResource HudPanelRadius}"
            ActualThemeChanged="RootBorder_ActualThemeChanged">
        <Border.Resources>
            <Storyboard
                x:Key="LoadingPulseStoryboard"
                AutoReverse="True"
                RepeatBehavior="Forever">
                <DoubleAnimation
                    Storyboard.TargetName="LoadingSkeleton1"
                    Storyboard.TargetProperty="Opacity"
                    From="0.35"
                    To="0.85"
                    Duration="0:0:1.05" />
                <DoubleAnimation
                    Storyboard.TargetName="LoadingSkeleton2"
                    Storyboard.TargetProperty="Opacity"
                    From="0.35"
                    To="0.85"
                    BeginTime="0:0:0.12"
                    Duration="0:0:1.05" />
                <DoubleAnimation
                    Storyboard.TargetName="LoadingSkeleton3"
                    Storyboard.TargetProperty="Opacity"
                    From="0.35"
                    To="0.85"
                    BeginTime="0:0:0.24"
                    Duration="0:0:1.05" />
            </Storyboard>
        </Border.Resources>
        <Grid x:Name="RootGrid" Padding="6,4">
            <Grid x:Name="AmbientBackdrop" IsHitTestVisible="False">
<Grid.Background>Transparent</Grid.Background>
                <Ellipse Width="440" Height="230" Margin="-155,-105,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.55" Visibility="Collapsed">
                    <Ellipse.Fill><RadialGradientBrush><GradientStop Offset="0" Color="#5030C7FF" /><GradientStop Offset="0.45" Color="#303B8FD4" /><GradientStop Offset="1" Color="#00205DB0" /></RadialGradientBrush></Ellipse.Fill>
                </Ellipse>
                <Grid Height="185" VerticalAlignment="Top">
                    <Border Opacity="0.35" Visibility="Collapsed">
                        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Offset="0" Color="#3A123B68" /><GradientStop Offset="0.48" Color="#161C4C72" /><GradientStop Offset="1" Color="#00071422" /></LinearGradientBrush></Border.Background>
                    </Border>
                    <Path Data="M 8,167 C 65,162 85,108 182,93 C 220,85 250,90 290,84" Stretch="Fill" StrokeThickness="8" Opacity="0.04">
                        <Path.Stroke><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Offset="0" Color="#FF38C7FF" /><GradientStop Offset="0.55" Color="#FF567DE0" /><GradientStop Offset="1" Color="#00345BA0" /></LinearGradientBrush></Path.Stroke>
                    </Path>
                    <Path Data="M 8,167 C 65,162 85,108 182,93 C 220,85 250,90 290,84" Stretch="Fill" StrokeThickness="1.2" Opacity="0.18">
                        <Path.Stroke><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Offset="0" Color="#FF54D6FF" /><GradientStop Offset="0.55" Color="#FF657FE6" /><GradientStop Offset="1" Color="#00345BA0" /></LinearGradientBrush></Path.Stroke>
                    </Path>
                </Grid>
                <Grid Height="80" VerticalAlignment="Bottom">
                    <Border Opacity="0.30" Visibility="Collapsed">
                        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Offset="0" Color="#00071422" /><GradientStop Offset="0.58" Color="#171B5A92" /><GradientStop Offset="1" Color="#501779C4" /></LinearGradientBrush></Border.Background>
                    </Border>
                    <Path Data="M 45,166 C 145,161 174,82 285,83 C 376,84 415,114 535,38" Stretch="Fill" StrokeThickness="10" Opacity="0.06">
                        <Path.Stroke><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Offset="0" Color="#00365B90" /><GradientStop Offset="0.45" Color="#FF4DBDFF" /><GradientStop Offset="1" Color="#FF7055D8" /></LinearGradientBrush></Path.Stroke>
                    </Path>
                    <Path Data="M 45,166 C 145,161 174,82 285,83 C 376,84 415,114 535,38" Stretch="Fill" StrokeThickness="1.5" Opacity="0.30">
                        <Path.Stroke><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Offset="0" Color="#00365B90" /><GradientStop Offset="0.45" Color="#FF64D2FF" /><GradientStop Offset="1" Color="#FF8062E8" /></LinearGradientBrush></Path.Stroke>
                    </Path>
                </Grid>
                <Ellipse Width="600" Height="70" Margin="-30,0,-30,-35" HorizontalAlignment="Center" VerticalAlignment="Bottom" Opacity="0.45" Visibility="Collapsed">
                    <Ellipse.Fill><RadialGradientBrush><GradientStop Offset="0" Color="#8064DFFF" /><GradientStop Offset="0.38" Color="#503BA5F0" /><GradientStop Offset="0.76" Color="#20337DC2" /><GradientStop Offset="1" Color="#00164A90" /></RadialGradientBrush></Ellipse.Fill>
                </Ellipse>
            </Grid>
            <Grid
                x:Name="CollapsedPanel"
                Visibility="{Binding CollapsedVisibility}">
                <Grid
                    x:Name="CollapsedDragSurface"
                    Padding="10,0"
                    Background="Transparent"
                    PointerPressed="DragSurface_PointerPressed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="ExpandButton"
                        Grid.Column="0"
                        Width="32"
                        Height="32"
                        Margin="0,0,10,0"
                        Padding="0"
                        Click="ExpandButton_Click"
                        Style="{StaticResource HudIconButtonStyle}"
                        ToolTipService.ToolTip="展开 AgentHUD">
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            FontSize="12"
                            Glyph="&#xE70D;" />
                    </Button>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse
                                    Width="6"
                                    Height="6"
                                    VerticalAlignment="Center"
                                    Fill="{ThemeResource HudWorkingBrush}" />
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource HudTextPrimaryBrush}"
                                    Text="{Binding WorkingCount}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse
                                    Width="6"
                                    Height="6"
                                    VerticalAlignment="Center"
                                    Fill="{ThemeResource HudWaitingBrush}" />
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource HudTextPrimaryBrush}"
                                    Text="{Binding WaitingCount}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse
                                    Width="6"
                                    Height="6"
                                    VerticalAlignment="Center"
                                    Fill="{ThemeResource HudCompletedBrush}" />
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource HudTextPrimaryBrush}"
                                    Text="{Binding CompletedCount}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse
                                    Width="6"
                                    Height="6"
                                    VerticalAlignment="Center"
                                    Fill="{ThemeResource HudFailedBrush}" />
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource HudTextPrimaryBrush}"
                                    Text="{Binding FailedCount}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource HudTextSecondaryBrush}"
                            MaxLines="1"
                            Text="{Binding CompactDisplayText}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="20">
                        <Button
                            Click="PinButton_Click"
                            Style="{StaticResource HudIconButtonStyle}"
                            ToolTipService.ToolTip="锁定窗口位置">
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                FontSize="14"
                                Glyph="{Binding PinGlyph}" />
                        </Button>
                        <Button
                            Click="LinkButton_Click"
                            Style="{StaticResource HudIconButtonStyle}"
                            ToolTipService.ToolTip="手机关联">
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                FontSize="14"
                                Glyph="&#xE8EA;" />
                        </Button>
                        <Button
                            Click="PrivacyButton_Click"
                            Style="{StaticResource HudIconButtonStyle}"
                            ToolTipService.ToolTip="切换隐私模式">
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                FontSize="14"
                                Glyph="{Binding PrivacyGlyph}" />
                        </Button>
                        <Button
                            Click="SettingsButton_Click"
                            Style="{StaticResource HudIconButtonStyle}"
                            ToolTipService.ToolTip="AI 标题设置">
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                FontSize="14"
                                Glyph="&#xE712;" />
                        </Button>
                        <Button
                            Click="HideButton_Click"
                            Style="{StaticResource HudIconButtonStyle}"
                            ToolTipService.ToolTip="隐藏到系统托盘">
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                FontSize="14"
                                Glyph="&#xE711;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid
                x:Name="ExpandedPanel"
                Margin="0,-13,0,0"
                Visibility="{Binding ExpandedVisibility}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="78" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="42" />
                </Grid.RowDefinitions>

                <Grid
                    x:Name="ExpandedDragSurface"
                    Grid.Row="0"
                    Padding="11,16,12,6"
                    Background="Transparent"
                    PointerPressed="DragSurface_PointerPressed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="6">
                        <Grid Width="52" Height="52" VerticalAlignment="Center">
                            <!-- Four-point sparkle with a strong outer glow, as in the
                                 reference art: no tile, just the star and its halo. -->
                            <Ellipse
                                Width="52"
                                Height="52"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Offset="0" Color="#D887CFFF" />
                                        <GradientStop Offset="0.35" Color="#A84D8FFF" />
                                        <GradientStop Offset="0.68" Color="#5A4F5FE0" />
                                        <GradientStop Offset="1" Color="#0A2E5AB0" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Path
                                Width="34"
                                Height="34"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="M 15,0 C 16.2,8.4 21.6,13.8 30,15 C 21.6,16.2 16.2,21.6 15,30 C 13.8,21.6 8.4,16.2 0,15 C 8.4,13.8 13.8,8.4 15,0 Z"
                                Stretch="Uniform">
                                <Path.Fill>
                                    <LinearGradientBrush StartPoint="0.12,0" EndPoint="0.88,1">
                                        <GradientStop Offset="0" Color="#FFB0FFFF" />
                                        <GradientStop Offset="0.24" Color="#FF52E4FF" />
                                        <GradientStop Offset="0.50" Color="#FF4588FF" />
                                        <GradientStop Offset="0.76" Color="#FF985EFF" />
                                        <GradientStop Offset="1" Color="#FFE06CFF" />
                                    </LinearGradientBrush>
                                </Path.Fill>
                            </Path>
                        </Grid>
                        <StackPanel
                            VerticalAlignment="Center"
                            Spacing="1">
                            <TextBlock
                                FontFamily="Segoe UI Variable Display"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource HudTextPrimaryBrush}"
                                Text="AGENT HUD" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse
                                    Width="5"
                                    Height="5"
                                    VerticalAlignment="Center"
                                    Fill="{ThemeResource HudOnlineBrush}" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{ThemeResource HudTextSecondaryBrush}"
                                    Text="{Binding ActiveSummary}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="10">
                        <Grid Width="30" Height="30">
                            <Button
                                x:Name="RefreshButton"
                                Click="RefreshButton_Click"
                                Style="{StaticResource HudHeaderIconButtonStyle}"
                                ToolTipService.ToolTip="立即刷新">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="15"
                                    Glyph="{Binding RefreshGlyph}" />
                            </Button>
                            <ProgressRing
                                Width="16"
                                Height="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsActive="{Binding IsLoading}"
                                IsHitTestVisible="False"
                                Visibility="{Binding LoadingVisibility}" />
                        </Grid>
                        <Button
                            Click="PinButton_Click"
                            Style="{StaticResource HudHeaderIconButtonStyle}"
                            ToolTipService.ToolTip="锁定窗口位置">
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                FontSize="15"
                                Glyph="{Binding PinGlyph}" />
                        </Button>
                        <Button
                            Click="PrivacyButton_Click"
                            Style="{StaticResource HudHeaderIconButtonStyle}"
                            ToolTipService.ToolTip="切换隐私模式">
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                FontSize="15"
                                Glyph="&#xE701;" />
                        </Button>
                        <Button
                            Click="LinkButton_Click"
                            Style="{StaticResource HudHeaderIconButtonStyle}"
                            ToolTipService.ToolTip="手机关联">
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                FontSize="15"
                                Glyph="&#xE8EA;" />
                        </Button>
                        <Button
                            Click="SettingsButton_Click"
                            Style="{StaticResource HudHeaderIconButtonStyle}"
                            ToolTipService.ToolTip="AI 标题设置">
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                FontSize="15"
                                Glyph="&#xE713;" />
                        </Button>
                        <Button
                            Click="HideButton_Click"
                            Style="{StaticResource HudHeaderIconButtonStyle}"
                            ToolTipService.ToolTip="隐藏到系统托盘">
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                FontSize="15"
                                Glyph="&#xE711;" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid
                    Grid.Row="1"
                    Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Margin="7,24,7,12"
                        Padding="4"
                        Background="{ThemeResource HudSurfaceHazeBrush}"
                        BorderBrush="{ThemeResource HudStripBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="21">
                        <Grid
                            x:Name="StatusFilterStrip"
                            ColumnSpacing="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="0.95*" />
                                <ColumnDefinition Width="0.95*" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="0.95*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="StatusAllButton"
                                Grid.Column="0"
                                Click="StatusFilter_Click"
                                Style="{StaticResource HudFilterButtonStyle}"
                                Tag="All">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <Grid Width="14" Height="14">
                                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <Rectangle Grid.Row="0" Grid.Column="0" Margin="1.2" Fill="Transparent" Stroke="{ThemeResource HudGridIconBrush}" StrokeThickness="1.1" />
                                        <Rectangle Grid.Row="0" Grid.Column="1" Margin="1.2" Fill="Transparent" Stroke="{ThemeResource HudGridIconBrush}" StrokeThickness="1.1" />
                                        <Rectangle Grid.Row="1" Grid.Column="0" Margin="1.2" Fill="Transparent" Stroke="{ThemeResource HudGridIconBrush}" StrokeThickness="1.1" />
                                        <Rectangle Grid.Row="1" Grid.Column="1" Margin="1.2" Fill="Transparent" Stroke="{ThemeResource HudGridIconBrush}" StrokeThickness="1.1" />
                                    </Grid>
                                    <TextBlock Text="全部" />
                                    <Border
                                        Padding="5,1"
                                        Background="#50122A59"
                                        CornerRadius="8">
                                        <TextBlock
                                            x:Name="StatusAllCount"
                                            FontSize="11"
                                            Foreground="{ThemeResource HudTextPrimaryBrush}"
                                            Text="0" />
                                    </Border>
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="StatusWorkingButton"
                                Grid.Column="1"
                                Click="StatusFilter_Click"
                                Style="{StaticResource HudFilterButtonStyle}"
                                Tag="Working">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <FontIcon
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="13"
                                        Foreground="{ThemeResource HudWorkingBrush}"
                                        Glyph="&#xE821;" />
                                    <TextBlock Text="工作" />
                                    <Border
                                        Padding="5,1"
                                        Background="{ThemeResource HudCountBadgeBrush}"
                                        CornerRadius="8">
                                        <TextBlock
                                            x:Name="StatusWorkingCount"
                                            FontSize="11"
                                            Foreground="{ThemeResource HudWorkingBrush}"
                                            Text="0" />
                                    </Border>
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="StatusWaitingButton"
                                Grid.Column="2"
                                Click="StatusFilter_Click"
                                Style="{StaticResource HudFilterButtonStyle}"
                                Tag="Waiting">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <FontIcon
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="13"
                                        Foreground="{ThemeResource HudWaitingBrush}"
                                        Glyph="&#xE735;" />
                                    <TextBlock Text="等待" />
                                    <Border
                                        Padding="5,1"
                                        Background="{ThemeResource HudCountBadgeBrush}"
                                        CornerRadius="8">
                                        <TextBlock
                                            x:Name="StatusWaitingCount"
                                            FontSize="11"
                                            Foreground="{ThemeResource HudWaitingBrush}"
                                            Text="0" />
                                    </Border>
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="StatusCompletedButton"
                                Grid.Column="3"
                                Click="StatusFilter_Click"
                                Style="{StaticResource HudFilterButtonStyle}"
                                Tag="Completed">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <FontIcon
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="13"
                                        Foreground="{ThemeResource HudCompletedBrush}"
                                        Glyph="&#xE73E;" />
                                    <TextBlock Text="完成" />
                                    <Border
                                        Padding="5,1"
                                        Background="{ThemeResource HudCountBadgeBrush}"
                                        CornerRadius="8">
                                        <TextBlock
                                            x:Name="StatusCompletedCount"
                                            FontSize="11"
                                            Foreground="{ThemeResource HudCompletedBrush}"
                                            Text="0" />
                                    </Border>
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="StatusFailedButton"
                                Grid.Column="4"
                                Click="StatusFilter_Click"
                                Style="{StaticResource HudFilterButtonStyle}"
                                Tag="Failed">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <FontIcon
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="13"
                                        Foreground="{ThemeResource HudFailedBrush}"
                                        Glyph="&#xE7BA;" />
                                    <TextBlock Text="错误" />
                                    <Border
                                        Padding="5,1"
                                        Background="{ThemeResource HudCountBadgeBrush}"
                                        CornerRadius="8">
                                        <TextBlock
                                            x:Name="StatusFailedCount"
                                            FontSize="11"
                                            Foreground="{ThemeResource HudFailedBrush}"
                                            Text="0" />
                                    </Border>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <Border
                        Grid.Row="1"
                        Margin="7,0,7,7"
                        Padding="4,8"
                        Background="{ThemeResource HudSurfaceHazeBrush}"
                        BorderBrush="{ThemeResource HudStripBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="21">
                        <ScrollViewer
                            Grid.Column="0"
                            HorizontalScrollBarVisibility="Hidden"
                            HorizontalScrollMode="Enabled"
                            VerticalScrollMode="Disabled">
                            <StackPanel
                                x:Name="ProviderFilterStrip"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    x:Name="ProviderAllButton"
                                    Click="ProviderFilter_Click"
                                    Style="{StaticResource HudFilterButtonStyle}"
                                    Tag="All">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="全部" />
                                        <Border
                                            Padding="5,2"
                                            Background="Transparent"
                                            CornerRadius="{ThemeResource HudPillRadius}">
                                            <TextBlock
                                                x:Name="ProviderAllCount"
                                                FontSize="11"
                                                Foreground="{ThemeResource HudTextPrimaryBrush}"
                                                Text="0" />
                                        </Border>
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="ProviderCodexButton"
                                    Click="ProviderFilter_Click"
                                    Style="{StaticResource HudFilterButtonStyle}"
                                    Tag="Codex">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Codex" Foreground="{ThemeResource HudCodexBrush}" />
                                        <Border
                                            Padding="5,1"
                                            Background="{ThemeResource HudCountBadgeBrush}"
                                            CornerRadius="8">
                                            <TextBlock
                                                x:Name="ProviderCodexCount"
                                                FontSize="11"
                                                Foreground="{ThemeResource HudCodexBrush}"
                                                Text="0" />
                                        </Border>
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="ProviderClaudeButton"
                                    Click="ProviderFilter_Click"
                                    Style="{StaticResource HudFilterButtonStyle}"
                                    Tag="Claude">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Claude" Foreground="{ThemeResource HudClaudeBrush}" />
                                        <Border
                                            Padding="5,1"
                                            Background="{ThemeResource HudCountBadgeBrush}"
                                            CornerRadius="8">
                                            <TextBlock
                                                x:Name="ProviderClaudeCount"
                                                FontSize="11"
                                                Foreground="{ThemeResource HudClaudeBrush}"
                                                Text="0" />
                                        </Border>
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="ProviderPiButton"
                                    Click="ProviderFilter_Click"
                                    Style="{StaticResource HudFilterButtonStyle}"
                                    Tag="Pi">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Pi" Foreground="{ThemeResource HudPiBrush}" />
                                        <Border
                                            Padding="5,1"
                                            Background="{ThemeResource HudCountBadgeBrush}"
                                            CornerRadius="8">
                                            <TextBlock
                                                x:Name="ProviderPiCount"
                                                FontSize="11"
                                                Foreground="{ThemeResource HudPiBrush}"
                                                Text="0" />
                                        </Border>
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="ProviderOpenCodeButton"
                                    Click="ProviderFilter_Click"
                                    Style="{StaticResource HudFilterButtonStyle}"
                                    Tag="OpenCode">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="OpenCode" Foreground="{ThemeResource HudOpenCodeBrush}" />
                                        <Border
                                            Padding="5,1"
                                            Background="{ThemeResource HudCountBadgeBrush}"
                                            CornerRadius="8">
                                            <TextBlock
                                                x:Name="ProviderOpenCodeCount"
                                                FontSize="11"
                                                Foreground="{ThemeResource HudOpenCodeBrush}"
                                                Text="0" />
                                        </Border>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border
                        Grid.RowSpan="2"
                        Margin="12,76,12,0"
                        Padding="12,9"
                        VerticalAlignment="Top"
                        Background="{ThemeResource HudRaisedBrush}"
                        BorderBrush="{ThemeResource HudCompletedBrush}"
                        BorderThickness="1"
                        Canvas.ZIndex="20"
                        CornerRadius="{ThemeResource HudCardRadius}"
                        Visibility="{Binding ImportantNoticeVisibility}">
                        <Grid ColumnSpacing="9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                Grid.Column="0"
                                VerticalAlignment="Top"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="13"
                                Foreground="{ThemeResource HudCompletedBrush}"
                                Glyph="&#xE7BA;" />
                            <TextBlock
                                Grid.Column="1"
                                FontSize="11.5"
                                Foreground="{ThemeResource HudTextPrimaryBrush}"
                                MaxLines="2"
                                Text="{Binding ImportantNoticeText}"
