<Application
    x:Class="AgentHUD.Windows.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="HudWindowBrush" Color="#F2F5F9" />
                    <SolidColorBrush x:Key="HudSurfaceBrush" Color="#F9FFFFFF" />
                    <SolidColorBrush x:Key="HudRaisedBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="HudControlFillBrush" Color="#14101826" />
                    <SolidColorBrush x:Key="HudControlHoverBrush" Color="#241D2938" />
                    <SolidColorBrush x:Key="HudBorderBrush" Color="#38101826" />
                    <SolidColorBrush x:Key="HudBorderStrongBrush" Color="#4A101826" />
                    <SolidColorBrush x:Key="HudDividerBrush" Color="#30101826" />
                    <SolidColorBrush x:Key="HudTextPrimaryBrush" Color="#09111E" />
                    <SolidColorBrush x:Key="HudTextSecondaryBrush" Color="#354052" />
                    <SolidColorBrush x:Key="HudTextTertiaryBrush" Color="#5A6576" />
                    <SolidColorBrush x:Key="HudSelectionBrush" Color="#E3EDFC" />
                    <SolidColorBrush x:Key="HudSelectionBorderBrush" Color="#2F78D8" />
                    <SolidColorBrush x:Key="HudShadowBrush" Color="#36111A2B" />
                    <SolidColorBrush x:Key="HudPrivacyBrush" Color="#FFF3CF" />
                    <SolidColorBrush x:Key="HudWorkingBrush" Color="#0053C7" />
                    <SolidColorBrush x:Key="HudWaitingBrush" Color="#8A4E00" />
                    <SolidColorBrush x:Key="HudCompletedBrush" Color="#007347" />
                    <SolidColorBrush x:Key="HudFailedBrush" Color="#B80F2B" />
                    <SolidColorBrush x:Key="HudCodexBrush" Color="#0053C7" />
                    <SolidColorBrush x:Key="HudClaudeBrush" Color="#A83A06" />
                    <SolidColorBrush x:Key="HudPiBrush" Color="#176612" />
                    <SolidColorBrush x:Key="HudOpenCodeBrush" Color="#00776B" />
                    <SolidColorBrush x:Key="HudImportantBrush" Color="#8A4E00" />
                    <SolidColorBrush x:Key="HudWorkingTintBrush" Color="#220053C7" />
                    <SolidColorBrush x:Key="HudWaitingTintBrush" Color="#278A4E00" />
                    <SolidColorBrush x:Key="HudCompletedTintBrush" Color="#26007347" />
                    <SolidColorBrush x:Key="HudFailedTintBrush" Color="#28B80F2B" />
                    <SolidColorBrush x:Key="HudNeutralTintBrush" Color="#18111826" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="HudWindowBrush" Color="#101722" />
                    <SolidColorBrush x:Key="HudSurfaceBrush" Color="#E619222F" />
                    <SolidColorBrush x:Key="HudRaisedBrush" Color="#F21D2735" />
                    <SolidColorBrush x:Key="HudControlFillBrush" Color="#24FFFFFF" />
                    <SolidColorBrush x:Key="HudControlHoverBrush" Color="#38FFFFFF" />
                    <SolidColorBrush x:Key="HudBorderBrush" Color="#42FFFFFF" />
                    <SolidColorBrush x:Key="HudBorderStrongBrush" Color="#50FFFFFF" />
                    <SolidColorBrush x:Key="HudDividerBrush" Color="#18FFFFFF" />
                    <SolidColorBrush x:Key="HudTextPrimaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="HudTextSecondaryBrush" Color="#D6DEE9" />
                    <SolidColorBrush x:Key="HudTextTertiaryBrush" Color="#A9B5C5" />
                    <SolidColorBrush x:Key="HudSelectionBrush" Color="#33465C" />
                    <SolidColorBrush x:Key="HudSelectionBorderBrush" Color="#6B9FEF" />
                    <SolidColorBrush x:Key="HudShadowBrush" Color="#99000000" />
                    <SolidColorBrush x:Key="HudPrivacyBrush" Color="#44351B" />
                    <SolidColorBrush x:Key="HudWorkingBrush" Color="#55ADFF" />
                    <SolidColorBrush x:Key="HudWaitingBrush" Color="#FFCA4F" />
                    <SolidColorBrush x:Key="HudCompletedBrush" Color="#45E594" />
                    <SolidColorBrush x:Key="HudFailedBrush" Color="#FF667A" />
                    <SolidColorBrush x:Key="HudCodexBrush" Color="#68B2FF" />
                    <SolidColorBrush x:Key="HudClaudeBrush" Color="#FF9A62" />
                    <SolidColorBrush x:Key="HudPiBrush" Color="#8BE879" />
                    <SolidColorBrush x:Key="HudOpenCodeBrush" Color="#4FD1C5" />
                    <SolidColorBrush x:Key="HudImportantBrush" Color="#FFD45E" />
                    <SolidColorBrush x:Key="HudWorkingTintBrush" Color="#3055A7FF" />
                    <SolidColorBrush x:Key="HudWaitingTintBrush" Color="#2EFFC857" />
                    <SolidColorBrush x:Key="HudCompletedTintBrush" Color="#2B43E58D" />
                    <SolidColorBrush x:Key="HudFailedTintBrush" Color="#2EFF667A" />
                    <SolidColorBrush x:Key="HudNeutralTintBrush" Color="#1FFFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="HudWindowBrush" Color="#000000" />
                    <SolidColorBrush x:Key="HudSurfaceBrush" Color="#F0000000" />
                    <SolidColorBrush x:Key="HudRaisedBrush" Color="#FF101010" />
                    <SolidColorBrush x:Key="HudControlFillBrush" Color="#FF202020" />
                    <SolidColorBrush x:Key="HudControlHoverBrush" Color="#FF343434" />
                    <SolidColorBrush x:Key="HudBorderBrush" Color="#FFB8B8B8" />
                    <SolidColorBrush x:Key="HudBorderStrongBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="HudDividerBrush" Color="#FF9A9A9A" />
                    <SolidColorBrush x:Key="HudTextPrimaryBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="HudTextSecondaryBrush" Color="#FFF0F0F0" />
                    <SolidColorBrush x:Key="HudTextTertiaryBrush" Color="#FFD0D0D0" />
                    <SolidColorBrush x:Key="HudSelectionBrush" Color="#FF003E78" />
                    <SolidColorBrush x:Key="HudSelectionBorderBrush" Color="#FF8CCBFF" />
                    <SolidColorBrush x:Key="HudShadowBrush" Color="#FF000000" />
                    <SolidColorBrush x:Key="HudPrivacyBrush" Color="#FF3B2F00" />
                    <SolidColorBrush x:Key="HudWorkingBrush" Color="#FF66B7FF" />
                    <SolidColorBrush x:Key="HudWaitingBrush" Color="#FFFFD84D" />
                    <SolidColorBrush x:Key="HudCompletedBrush" Color="#FF55F59B" />
                    <SolidColorBrush x:Key="HudFailedBrush" Color="#FFFF7B8A" />
                    <SolidColorBrush x:Key="HudCodexBrush" Color="#FF66B7FF" />
                    <SolidColorBrush x:Key="HudClaudeBrush" Color="#FFFFA36D" />
                    <SolidColorBrush x:Key="HudPiBrush" Color="#FF98F08A" />
                    <SolidColorBrush x:Key="HudOpenCodeBrush" Color="#FF70D7C8" />
                    <SolidColorBrush x:Key="HudImportantBrush" Color="#FFFFD84D" />
                    <SolidColorBrush x:Key="HudWorkingTintBrush" Color="#FF10283F" />
                    <SolidColorBrush x:Key="HudWaitingTintBrush" Color="#FF342A00" />
                    <SolidColorBrush x:Key="HudCompletedTintBrush" Color="#FF0C301D" />
                    <SolidColorBrush x:Key="HudFailedTintBrush" Color="#FF3B1219" />
                    <SolidColorBrush x:Key="HudNeutralTintBrush" Color="#FF202020" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <CornerRadius x:Key="HudPanelRadius">14</CornerRadius>
            <CornerRadius x:Key="HudHeroRadius">12</CornerRadius>
            <CornerRadius x:Key="HudCardRadius">10</CornerRadius>
            <CornerRadius x:Key="HudControlRadius">7</CornerRadius>
            <CornerRadius x:Key="HudMicroRadius">5</CornerRadius>

            <x:Double x:Key="HudSpacingXXS">2</x:Double>
            <x:Double x:Key="HudSpacingXS">4</x:Double>
            <x:Double x:Key="HudSpacingSM">6</x:Double>
            <x:Double x:Key="HudSpacingMD">8</x:Double>
            <x:Double x:Key="HudSpacingLG">12</x:Double>
            <x:Double x:Key="HudSpacingXL">16</x:Double>
            <x:Double x:Key="HudSpacingXXL">24</x:Double>

            <x:Double x:Key="HudFontSizeDisplay">20</x:Double>
            <x:Double x:Key="HudFontSizeTitle">13</x:Double>
            <x:Double x:Key="HudFontSizeBody">12</x:Double>
            <x:Double x:Key="HudFontSizeLabel">11</x:Double>
            <x:Double x:Key="HudFontSizeCaption">10.5</x:Double>
            <x:Double x:Key="HudFontSizeMicro">9.5</x:Double>
            <x:Double x:Key="HudFontSizeAgent">8.5</x:Double>

            <Duration x:Key="HudDurationEnter">0:0:0.32</Duration>
            <Duration x:Key="HudDurationExit">0:0:0.14</Duration>
            <Duration x:Key="HudDurationState">0:0:0.30</Duration>
            <Duration x:Key="HudDurationPage">0:0:0.18</Duration>


            <Style x:Key="HudIconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource HudTextSecondaryBrush}" />
            </Style>

            <Style x:Key="HudFilterButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource HudTextSecondaryBrush}" />
            </Style>

            <Style
                x:Key="HudFilterSelectedButtonStyle"
                TargetType="Button"
                BasedOn="{StaticResource HudFilterButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource HudSelectionBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource HudSelectionBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{ThemeResource HudTextPrimaryBrush}" />
            </Style>

            <Style x:Key="HudTinyButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="23" />
                <Setter Property="Height" Value="23" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Background" Value="{ThemeResource HudControlFillBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                <Setter Property="FontSize" Value="9" />
                <Setter Property="Foreground" Value="{ThemeResource HudTextSecondaryBrush}" />
            </Style>

            <Style x:Key="HudSectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource HudTextSecondaryBrush}" />
                <Setter Property="CharacterSpacing" Value="20" />
            </Style>

            <Style x:Key="SessionListViewItemStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <ContentPresenter
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
