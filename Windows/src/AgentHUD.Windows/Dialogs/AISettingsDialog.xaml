<ContentDialog
    x:Class="AgentHUD.Windows.AISettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AI 标题与显示设置"
    CloseButtonText="关闭"
    DefaultButton="Primary"
    Opened="AISettingsDialog_Opened"
    PrimaryButtonClick="AISettingsDialog_PrimaryButtonClick"
    PrimaryButtonText="保存"
    SecondaryButtonClick="AISettingsDialog_SecondaryButtonClick"
    SecondaryButtonText="测试连接">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            Width="486"
            Spacing="15">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="40"
                    Height="40"
                    VerticalAlignment="Top"
                    Background="{ThemeResource HudSelectionBrush}"
                    CornerRadius="10">
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="18"
                        Foreground="{ThemeResource HudWorkingBrush}"
                        Glyph="&#xE945;" />
                </Border>
                <StackPanel
                    Grid.Column="1"
                    Spacing="3">
                    <TextBlock
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="让标题一眼看懂刚刚做了什么" />
                    <TextBlock
                        FontSize="11.5"
                        Foreground="{ThemeResource HudTextSecondaryBrush}"
                        Text="AI 会结合最近一次用户输入和图片生成短标题；手动备注始终优先。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <StackPanel Spacing="10">
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Text="面板尺寸" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <NumberBox
                        x:Name="ExpandedWidthBox"
                        Header="展开宽度"
                        LargeChange="10"
                        Maximum="720"
                        Minimum="360"
                        SmallChange="1"
                        SpinButtonPlacementMode="Inline" />
                    <NumberBox
                        x:Name="ExpandedHeightBox"
                        Grid.Column="1"
                        Header="展开高度"
                        LargeChange="10"
                        Maximum="1000"
                        Minimum="480"
                        SmallChange="1"
                        SpinButtonPlacementMode="Inline" />
                </Grid>
                <TextBlock
                    FontSize="10.5"
                    Foreground="{ThemeResource HudTextTertiaryBrush}"
                    Text="宽度上限 720，高度上限 1000；收起尺寸保持不变。"
                    TextWrapping="Wrap" />
            </StackPanel>

            <ToggleSwitch
                x:Name="EnabledSwitch"
                Header="启用 AI 标题" />

            <StackPanel Spacing="6">
                <TextBlock
                    FontSize="11.5"
                    FontWeight="SemiBold"
                    Text="API 地址" />
                <TextBox
                    x:Name="EndpointBox"
                    PlaceholderText="https://example.com/v1" />
                <TextBlock
                    FontSize="10.5"
                    Foreground="{ThemeResource HudTextTertiaryBrush}"
                    Text="支持 OpenAI 兼容的 /v1 地址，应用会自动补全 /chat/completions。" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock
                    FontSize="11.5"
                    FontWeight="SemiBold"
                    Text="模型" />
                <TextBox
                    x:Name="ModelBox"
                    PlaceholderText="kimi-k3.1-pro" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock
                    FontSize="11.5"
                    FontWeight="SemiBold"
                    Text="API Key" />
                <PasswordBox
                    x:Name="ApiKeyBox"
                    PasswordRevealMode="Peek"
                    PlaceholderText="填写 API Key" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="6">
                        <FontIcon
                            VerticalAlignment="Center"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="9"
                            Foreground="{ThemeResource HudTextTertiaryBrush}"
                            Glyph="&#xE72E;" />
                        <TextBlock
                            x:Name="ApiKeyHintText"
                            VerticalAlignment="Center"
                            FontSize="10.5"
                            Foreground="{ThemeResource HudTextSecondaryBrush}" />
                    </StackPanel>
                    <Button
                        x:Name="DeleteKeyButton"
                        Grid.Column="1"
                        Padding="8,4"
                        Click="DeleteKeyButton_Click"
                        Content="删除密钥"
                        CornerRadius="6"
                        FontSize="10.5"
                        Foreground="{ThemeResource HudFailedBrush}" />
                </Grid>
            </StackPanel>

            <InfoBar
                x:Name="StatusBar"
                IsClosable="False"
                IsOpen="False" />

            <Border
                Padding="11,9"
                Background="{ThemeResource HudControlFillBrush}"
                CornerRadius="8">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8">
                    <FontIcon
                        VerticalAlignment="Top"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="11"
                        Foreground="{ThemeResource HudTextSecondaryBrush}"
                        Glyph="&#xE72E;" />
                    <TextBlock
                        FontSize="10.5"
                        Foreground="{ThemeResource HudTextSecondaryBrush}"
                        Text="API Key 只保存到 Windows 凭据管理器，不写入配置文件、日志或安装目录。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
