<ContentDialog
    x:Class="AgentHUD.Windows.LinkSettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="手机关联"
    CloseButtonText="关闭"
    PrimaryButtonClick="NewPairingButton_Click"
    PrimaryButtonText="生成新配对码"
    SecondaryButtonClick="RestartButton_Click"
    SecondaryButtonText="重启服务"
    Loaded="LinkSettingsDialog_Loaded"
    Unloaded="LinkSettingsDialog_Unloaded">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Width="430" Spacing="13">
            <TextBlock
                Foreground="{ThemeResource HudTextSecondaryBrush}"
                FontSize="11.5"
                Text="使用手机扫码或在 App 中输入验证码。配对码两分钟后失效，每台设备都有独立、可撤销的只读令牌。"
                TextWrapping="Wrap" />

            <TextBlock
                x:Name="ServiceText"
                Foreground="{ThemeResource HudTextTertiaryBrush}"
                FontSize="10.5"
                TextWrapping="Wrap" />

            <Border
                HorizontalAlignment="Center"
                Padding="12"
                Background="White"
                CornerRadius="12">
                <Image
                    x:Name="QrImage"
                    Width="230"
                    Height="230" />
            </Border>

            <TextBlock
                x:Name="CodeText"
                HorizontalAlignment="Center"
                FontFamily="Consolas"
                FontSize="30"
                FontWeight="Bold"
                Text="------" />

            <TextBlock
                x:Name="ExpiresText"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource HudTextSecondaryBrush}"
                FontSize="11" />

            <TextBlock
                x:Name="StatusText"
                Foreground="{ThemeResource HudFailedBrush}"
                FontSize="10.5"
                TextWrapping="Wrap" />

            <Border
                Padding="10"
                Background="{ThemeResource HudControlFillBrush}"
                CornerRadius="8">
                <TextBlock
                    Foreground="{ThemeResource HudTextSecondaryBrush}"
                    FontSize="10.5"
                    Text="首版仅提供会话状态、标题、项目别名和进度。不会发送 API Key、完整路径、原始日志或图片。Windows 防火墙提示时请仅允许专用网络。"
                    TextWrapping="Wrap" />
            </Border>

            <TextBlock FontSize="12" FontWeight="SemiBold" Text="已关联设备" />
            <ListView x:Name="DeviceList" MaxHeight="180" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock FontSize="12" Text="{Binding Name}" />
                                <TextBlock
                                    Foreground="{ThemeResource HudTextTertiaryBrush}"
                                    FontSize="10"
                                    Text="{Binding PairedAt}" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Padding="8,4"
                                Click="RevokeDevice_Click"
                                Content="撤销"
                                CornerRadius="6"
                                FontSize="10.5"
                                Foreground="{ThemeResource HudFailedBrush}"
                                Tag="{Binding Id}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
