<ContentDialog
    x:Class="AgentHUD.Windows.ImagePreviewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="图片预览"
    CloseButtonText="关闭"
    Closed="ImagePreviewDialog_Closed"
    KeyDown="ImagePreviewDialog_KeyDown"
    MaxWidth="900"
    MinWidth="800"
    Opened="ImagePreviewDialog_Opened">

    <Grid
        Width="760"
        Height="520">
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Padding="2,0"
            Background="{ThemeResource HudSurfaceBrush}"
            ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <FontIcon
                    FontFamily="Segoe Fluent Icons"
                    FontSize="12"
                    Foreground="{ThemeResource HudTextSecondaryBrush}"
                    Glyph="&#xEB9F;" />
                <TextBlock
                    x:Name="CounterText"
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="11.5"
                    FontWeight="SemiBold"
                    Text="[图片1]" />
            </StackPanel>

            <Button
                Grid.Column="1"
                Click="ZoomOutButton_Click"
                Style="{StaticResource HudIconButtonStyle}"
                ToolTipService.ToolTip="缩小">
                <FontIcon
                    FontFamily="Segoe Fluent Icons"
                    FontSize="10"
                    Glyph="&#xE71F;" />
            </Button>
            <TextBlock
                x:Name="ZoomText"
                Grid.Column="2"
                Width="44"
                VerticalAlignment="Center"
                FontFamily="Consolas"
                FontSize="10.5"
                Foreground="{ThemeResource HudTextSecondaryBrush}"
                Text="100%"
                TextAlignment="Center" />
            <Button
                Grid.Column="3"
                Click="ZoomInButton_Click"
                Style="{StaticResource HudIconButtonStyle}"
                ToolTipService.ToolTip="放大">
                <FontIcon
                    FontFamily="Segoe Fluent Icons"
                    FontSize="10"
                    Glyph="&#xE8A3;" />
            </Button>
            <Button
                Grid.Column="4"
                Click="ResetZoomButton_Click"
                Style="{StaticResource HudIconButtonStyle}"
                ToolTipService.ToolTip="重置缩放">
                <FontIcon
                    FontFamily="Segoe Fluent Icons"
                    FontSize="10"
                    Glyph="&#xE777;" />
            </Button>
        </Grid>

        <Grid
            Grid.Row="1"
            Background="{ThemeResource HudWindowBrush}">
            <ScrollViewer
                x:Name="ImageScrollViewer"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Enabled"
                IsTabStop="True"
                KeyDown="ImagePreviewDialog_KeyDown"
                MaxZoomFactor="4"
                MinZoomFactor="0.5"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Enabled"
                ZoomMode="Enabled">
                <Grid
                    x:Name="ImageHost"
                    MinWidth="700"
                    MinHeight="430">
                    <Image
                        x:Name="PreviewImage"
                        Margin="34"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        DoubleTapped="PreviewImage_DoubleTapped"
                        Stretch="Uniform" />
                    <StackPanel
                        x:Name="UnavailablePanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="9"
                        Visibility="Collapsed">
                        <FontIcon
                            HorizontalAlignment="Center"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="32"
                            Foreground="{ThemeResource HudTextTertiaryBrush}"
                            Glyph="&#xEB9F;" />
                        <TextBlock
                            FontSize="12.5"
                            FontWeight="Medium"
                            Text="这张图片暂时无法读取" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Button
                x:Name="PreviousButton"
                Width="62"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                Click="PreviousButton_Click"
                ToolTipService.ToolTip="上一张（←）">
                <FontIcon
                    FontFamily="Segoe Fluent Icons"
                    FontSize="16"
                    Foreground="{ThemeResource HudTextSecondaryBrush}"
                    Glyph="&#xE76B;" />
            </Button>
            <Button
                x:Name="NextButton"
                Width="62"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Click="NextButton_Click"
                ToolTipService.ToolTip="下一张（→）">
                <FontIcon
                    FontFamily="Segoe Fluent Icons"
                    FontSize="16"
                    Foreground="{ThemeResource HudTextSecondaryBrush}"
                    Glyph="&#xE76C;" />
            </Button>
        </Grid>
    </Grid>
</ContentDialog>
