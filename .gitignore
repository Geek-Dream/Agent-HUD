# Local build outputs
.artifacts/

# Swift
.build/
.swiftpm/
build/
DerivedData/
*.app/

# .NET / WinUI
Windows/.dotnet/
Windows/**/bin/
Windows/**/obj/
Windows/artifacts/
Windows/ui-build/
Windows/*.log
*.user
