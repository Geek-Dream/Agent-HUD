# Local machine scratch notes (file lists kept outside version control)
local.txt
remote.txt

# Flutter Android runner is generated by CI (`flutter create --org com.geekdream`).
# Committing it would pin the wrong applicationId and skip the org flag.
# `mobile/.metadata` is deliberately NOT ignored: Flutter states it should be
# version controlled so tooling can track project upgrades.
mobile/android/
mobile/.flutter-plugins-dependencies
